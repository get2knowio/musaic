# Rust build output
rust/target/

# Generated synthetic test audio (rust/testdata/synthetic-library/gen_fixture_library.py).
# The manifest next to it IS committed: it carries every file's SHA-256.
rust/testdata/synthetic-library/library/
rust/testdata/synthetic-library/.library.tmp/

# Private test data, when checked out next to rust/ (never committed here)
private-testdata/

# Scratch space: library copies, config dirs, exports, logs
work/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# Python (test-data generator, notices script)
__pycache__/
*.pyc
.venv/

# Environment and secrets
.env
*.env.local

# Runtime data (user-local, not project files)
*.db-shm
*.db-wal

# macOS / editors
.DS_Store
.idea/
*.swp

# local
desktop/
# Claude Code's local state; the Spec Kit commands in skills/ are shared
.claude/*
!.claude/skills/

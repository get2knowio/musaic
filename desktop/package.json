{
  "name": "musaic-desktop",
  "version": "0.1.0-rc.3",
  "private": true,
  "description": "Electron desktop shell for Musaic (issue #8): spawns the FastAPI backend as a localhost sidecar and points a window at it.",
  "author": "Musaic contributors",
  "homepage": "https://github.com/get2knowio/musaic",
  "repository": {
    "type": "git",
    "url": "https://github.com/get2knowio/musaic.git"
  },
  "main": "dist/main.js",
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:python": "node build/fetch-python.mjs",
    "build:sidecar": "node build/build-sidecar.mjs",
    "build:binaries": "node build/fetch-binaries.mjs",
    "build:resources": "npm run build:python && npm run build:sidecar && npm run build:binaries",
    "validate:sidecar": "node build/validate-sidecar.mjs",
    "validate:binaries": "node build/validate-binaries.mjs",
    "pack": "npm run build && electron-builder --dir --config electron-builder.config.js",
    "dist": "npm run build && electron-builder --config electron-builder.config.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}

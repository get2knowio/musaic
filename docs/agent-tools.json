              "running",
              "succeeded",
              "failed",
              "cancelled",
              "denied",
              "expired"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "cancellation": {
            "$ref": "#/$defs/Cancellation"
          },
          "operationId": {
            "type": "string"
          },
          "state": {
            "$ref": "#/$defs/OperationState"
          }
        },
        "required": [
          "operationId",
          "state",
          "cancellation"
        ],
        "title": "OperationCancelOutput",
        "type": "object"
      },
      "title": "Cancel an operation"
    }
  ]

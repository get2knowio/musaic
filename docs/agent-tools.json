  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "cliName": "capabilities",
      "description": "What this pairing may do: its scopes and policy, the contract version, the registry digest and the configured library roots. Start here.",
      "id": "musaic_capabilities",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "title": "CapabilitiesInput",
        "type": "object"
      },
      "kinds": [
        "library.read"
      ],
      "outputSchema": {
        "$defs": {
          "ConfiguredRoot": {
            "description": "A library folder the app is configured with, by id and base name only.",
            "properties": {
              "name": {
                "type": "string"
              },
              "rootId": {
                "type": "string"
              }
            },
            "required": [
              "rootId",
              "name"
            ],
            "type": "object"
          },
          "Decision": {
            "description": "A policy decision. The order is the strictness: `Refuse` is the strongest.",
            "enum": [
              "allow",
              "ask",
              "refuse"
            ],
            "type": "string"
          },
          "PermissionKind": {
            "description": "What an agent may be allowed to do. A pairing's scope is a subset of these.",
            "enum": [
              "library.read",
              "proposal.submit",
              "compute.scan",
              "compute.analyze",
              "tags.write",
              "covers.write",
              "files.rename"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "appVersion": {
            "type": "string"
          },
          "configuredRoots": {
            "items": {
              "$ref": "#/$defs/ConfiguredRoot"
            },
            "type": "array"
          },
          "contractVersion": {
            "description": "Always \"1\".",
            "type": "string"
          },
          "instanceId": {
            "type": "string"
          },
          "policy": {
            "additionalProperties": false,
            "properties": {
              "compute.analyze": {
                "$ref": "#/$defs/Decision"
              },
              "compute.scan": {
                "$ref": "#/$defs/Decision"
              },
              "covers.write": {
                "$ref": "#/$defs/Decision"
              },
              "files.rename": {
                "$ref": "#/$defs/Decision"
              },
              "library.read": {
                "$ref": "#/$defs/Decision"
              },
              "proposal.submit": {
                "$ref": "#/$defs/Decision"
              },
              "tags.write": {
                "$ref": "#/$defs/Decision"
              }
            },
            "type": "object"
          },
          "profiles": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "registryDigest": {
            "type": "string"
          },
          "scopes": {
            "items": {
              "$ref": "#/$defs/PermissionKind"
            },
            "type": "array"
          }
        },
        "required": [
          "appVersion",
          "contractVersion",
          "registryDigest",
          "instanceId",
          "scopes",
          "policy",
          "profiles",
          "configuredRoots"
        ],
        "title": "CapabilitiesOutput",
        "type": "object"
      },
      "title": "Capabilities"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "cliName": "library-list",
      "description": "Page through the albums of the library, optionally filtered by a text query on the artist or title. Returns ids and display fields, never paths.",
      "id": "musaic_library_list",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "maxLength": 512,
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "maximum": 100,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "query": {
            "description": "Case-insensitive substring of the artist or the title.",
            "maxLength": 200,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "LibraryListInput",
        "type": "object"
      },
      "kinds": [
        "library.read"
      ],
      "outputSchema": {
        "$defs": {
          "AlbumSummary": {
            "properties": {
              "albumId": {
                "type": "string"
              },
              "artist": {
                "type": "string"
              },
              "hasCover": {
                "type": "boolean"
              },
              "missing": {
                "type": "boolean"
              },
              "title": {
                "type": "string"
              },
              "trackCount": {
                "minimum": 0,
                "type": "integer"
              },
              "year": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "albumId",
              "artist",
              "title",
              "trackCount",
              "missing",
              "hasCover"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/$defs/AlbumSummary"
            },
            "type": "array"
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "total": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "title": "LibraryListOutput",
        "type": "object"
      },
      "title": "List albums"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "cliName": "album-get",
      "description": "One album: its tags, its tracks (file names and tags) and its revision, which a fix proposal is bound to.",
      "id": "musaic_album_get",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "albumId": {
            "pattern": "^[0-9a-f]{16}$",
            "type": "string"
          }
        },
        "required": [
          "albumId"
        ],
        "title": "AlbumGetInput",
        "type": "object"
      },
      "kinds": [
        "library.read"
      ],
      "outputSchema": {
        "$defs": {
          "AlbumDetail": {
            "description": "The summary fields plus the folder's bare name, the stored tags and the\ndisc count. Never a path.",
            "properties": {
              "albumId": {
                "type": "string"
              },
              "artist": {
                "type": "string"
              },
              "discCount": {
                "minimum": 0,
                "type": "integer"
              },
              "folderName": {
                "type": "string"
              },
              "hasCover": {
                "type": "boolean"
              },
              "missing": {
                "type": "boolean"
              },
              "tags": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              "title": {
                "type": "string"
              },
              "trackCount": {
                "minimum": 0,
                "type": "integer"
              },
              "year": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "albumId",
              "artist",
              "title",
              "trackCount",
              "missing",
              "hasCover",
              "folderName",
              "tags",
              "discCount"
            ],
            "type": "object"
          },
          "Track": {
            "properties": {
              "artist": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "discNumber": {
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "durationSeconds": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "fileName": {
                "type": "string"
              },
              "tags": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "trackNumber": {
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "required": [
              "fileName",
              "tags"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "album": {
            "$ref": "#/$defs/AlbumDetail"
          },
          "revision": {
            "type": "string"
          },
          "tracks": {
            "items": {
              "$ref": "#/$defs/Track"
            },
            "type": "array"
          }
        },
        "required": [
          "album",
          "tracks",
          "revision"
        ],
        "title": "AlbumGetOutput",
        "type": "object"
      },
      "title": "Get an album"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "cliName": "resolution-get",
      "description": "The metadata resolution already stored for an album. It never starts a lookup; with nothing stored it answers not_resolved.",
      "id": "musaic_resolution_get",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "albumId": {
            "pattern": "^[0-9a-f]{16}$",
            "type": "string"
          }
        },
        "required": [
          "albumId"
        ],
        "title": "AlbumGetInput",
        "type": "object"
      },
      "kinds": [
        "library.read"
      ],
      "outputSchema": {
        "$defs": {
          "ResolutionStatus": {
            "enum": [
              "resolved",
              "not_resolved"
            ],
            "type": "string"
          },
          "ResolutionTrack": {
            "properties": {
              "fileName": {
                "type": "string"
              },
              "recordingMbid": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "fileName"
            ],
            "type": "object"
          },
          "ResolvedField": {
            "properties": {
              "confidence": {
                "type": "number"
              },
              "source": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "source",
              "confidence"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "anchor": {
            "type": [
              "string",
              "null"
            ]
          },
          "coverCandidate": {
            "type": "boolean"
          },
          "fields": {
            "additionalProperties": {
              "$ref": "#/$defs/ResolvedField"
            },
            "type": "object"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "status": {
            "$ref": "#/$defs/ResolutionStatus"
          },
          "strategy": {
            "type": [
              "string",
              "null"
            ]
          },
          "tracks": {
            "items": {
              "$ref": "#/$defs/ResolutionTrack"
            },
            "type": "array"
          }
        },
        "required": [

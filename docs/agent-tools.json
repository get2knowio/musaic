          "operationId"
        ],
        "title": "OperationGetInput",
        "type": "object"
      },
      "kinds": [
        "library.read"
      ],
      "outputSchema": {
        "$defs": {
          "AnalysisItem": {
            "properties": {
              "albumId": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "status": {
                "$ref": "#/$defs/FileStatus"
              }
            },
            "required": [
              "albumId",
              "kind",
              "status"
            ],
            "type": "object"
          },
          "ApplyResult": {
            "properties": {
              "albumIdAfter": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "cover": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/FileOutcome"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "files": {
                "items": {
                  "$ref": "#/$defs/FileOutcome"
                },
                "type": "array"
              },
              "renamed": {
                "description": "Whether the rename step ran and finished.",
                "type": "boolean"
              }
            },
            "required": [
              "files",
              "renamed"
            ],
            "type": "object"
          },
          "CheckRunSummary": {
            "properties": {
              "checkId": {
                "type": "string"
              },
              "failed": {
                "type": "boolean"
              },
              "findings": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "checkId",
              "findings",
              "failed"
            ],
            "type": "object"
          },
          "Counts": {
            "properties": {
              "done": {
                "minimum": 0,
                "type": "integer"
              },
              "failed": {
                "minimum": 0,
                "type": "integer"
              },
              "total": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "done",
              "total",
              "failed"
            ],
            "type": "object"
          },
          "FileOutcome": {
            "description": "One file's outcome, by bare file name.",
            "properties": {
              "fileName": {
                "type": "string"
              },
              "message": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "$ref": "#/$defs/FileStatus"
              }
            },
            "required": [
              "fileName",
              "status"
            ],
            "type": "object"
          },
          "FileStatus": {
            "enum": [
              "ok",
              "failed",
              "skipped"
            ],
            "type": "string"
          },
          "OperationResult": {
            "description": "The result of a finished operation; only the part its tool produces is set.",
            "properties": {
              "analysis": {
                "items": {
                  "$ref": "#/$defs/AnalysisItem"
                },
                "type": [
                  "array",
                  "null"
                ]
              },
              "apply": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ApplyResult"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "checks": {
                "items": {
                  "$ref": "#/$defs/CheckRunSummary"
                },
                "type": [
                  "array",
                  "null"
                ]
              },
              "scanAlbums": {
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "type": "object"
          },
          "OperationState": {
            "enum": [
              "awaiting_approval",
              "running",
              "succeeded",
              "failed",
              "cancelled",
              "denied",
              "expired"
            ],
            "type": "string"
          },
          "ToolError": {
            "description": "A failure a tool reports: `{code, message, details?}`. The message never\nholds a path, a secret or an argument value.",
            "properties": {
              "code": {
                "$ref": "#/$defs/ToolErrorCode"
              },
              "details": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": [
                  "object",
                  "null"
                ]
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          },
          "ToolErrorCode": {
            "description": "A stable error code.",
            "oneOf": [
              {
                "enum": [
                  "INVALID_INPUT",
                  "NOT_FOUND",
                  "MISSING_ALBUM",
                  "STALE_REVISION",
                  "PROPOSAL_EXPIRED",
                  "DIGEST_MISMATCH",
                  "APPROVAL_EXPIRED",
                  "IDEMPOTENCY_CONFLICT",
                  "CURSOR_STALE",
                  "BUSY",
                  "RESTORING",
                  "NO_LIBRARY",
                  "UNAVAILABLE",
                  "INTERNAL",
                  "APP_NOT_RUNNING",
                  "DESCRIPTOR_INVALID",
                  "NOT_PAIRED",
                  "PAIRING_REVOKED",
                  "INSTANCE_MISMATCH",
                  "LOCKED_OUT",
                  "PROFILE_UNSUPPORTED"
                ],
                "type": "string"
              },
              {
                "const": "FORBIDDEN",
                "description": "The scope or a Refuse policy denies it.",
                "type": "string"
              },
              {
                "const": "DENIED",
                "description": "The user denied it.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "approvalId": {
            "type": [
              "string",
              "null"
            ]
          },
          "counts": {
            "$ref": "#/$defs/Counts"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/$defs/ToolError"
              },
              {
                "type": "null"
              }
            ]
          },
          "operationId": {
            "type": "string"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/$defs/OperationResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "$ref": "#/$defs/OperationState"
          },
          "tool": {
            "type": "string"
          }
        },
        "required": [
          "operationId",
          "tool",
          "state",
          "counts"
        ],
        "title": "OperationGetOutput",
        "type": "object"
      },
      "title": "Get an operation"
    },

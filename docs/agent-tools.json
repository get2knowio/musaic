    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "cliName": "fix-preview",
      "description": "Validate a proposed change to one album's tags, cover or file names against its current revision and store it as a proposal. Writes nothing to the collection.",
      "id": "musaic_fix_preview",
      "inputSchema": {
        "$defs": {
          "CoverPatch": {
            "oneOf": [
              {
                "additionalProperties": false,
                "description": "The cover candidate of the stored resolution.",
                "properties": {
                  "source": {
                    "const": "resolution",
                    "type": "string"
                  }
                },
                "required": [
                  "source"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "A public `https` URL.",
                "properties": {
                  "source": {
                    "const": "url",
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  }
                },
                "required": [
                  "source",
                  "url"
                ],
                "type": "object"
              }
            ]
          },
          "ProposedPatch": {
            "additionalProperties": false,
            "properties": {
              "cover": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/CoverPatch"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rename": {
                "description": "Only `true`: rename the files and folder to the template names.",
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "tags": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/TagsPatch"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "type": "object"
          },
          "TagsPatch": {
            "additionalProperties": false,
            "description": "Tag changes: `null` clears a field.",
            "properties": {
              "album": {
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "description": "Album-level fields (`{FIELD: value|null}`).",
                "type": [
                  "object",
                  "null"
                ]
              },
              "tracks": {
                "additionalProperties": {
                  "additionalProperties": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "type": "object"
                },
                "description": "Track-level fields by file name, as `musaic_album_get` lists them.",
                "type": [
                  "object",
                  "null"
                ]
              }
            },
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "albumId": {
            "pattern": "^[0-9a-f]{16}$",
            "type": "string"
          },
          "baseRevision": {
            "description": "The `revision` from `musaic_album_get`.",
            "type": "string"
          },
          "proposedPatch": {
            "$ref": "#/$defs/ProposedPatch"
          }
        },
        "required": [
          "albumId",
          "baseRevision",
          "proposedPatch"
        ],
        "title": "FixPreviewInput",
        "type": "object"
      },
      "kinds": [
        "proposal.submit"
      ],
      "outputSchema": {
        "$defs": {
          "Effect": {
            "enum": [
              "writes_tags",
              "writes_cover",
              "renames_files",
              "renames_folder",
              "fetches_network"
            ],
            "type": "string"
          },
          "FixDiff": {
            "properties": {
              "cover": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "files": {
                "items": {
                  "$ref": "#/$defs/NameChange"
                },
                "type": "array"
              },
              "folder": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/NameChange"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "tags": {
                "items": {
                  "$ref": "#/$defs/TagChange"
                },
                "type": "array"
              }
            },
            "required": [
              "tags",
              "files"
            ],
            "type": "object"
          },
          "NameChange": {
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "type": "object"
          },
          "PermissionKind": {
            "description": "What an agent may be allowed to do. A pairing's scope is a subset of these.",
            "enum": [
              "library.read",
              "proposal.submit",
              "compute.scan",
              "compute.analyze",
              "tags.write",
              "covers.write",
              "files.rename"
            ],
            "type": "string"
          },
          "TagChange": {
            "properties": {
              "after": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "before": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "field": {
                "type": "string"
              },
              "scope": {
                "description": "`album`, or a file name.",
                "type": "string"
              }
            },
            "required": [
              "scope",
              "field"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "diff": {
            "$ref": "#/$defs/FixDiff"
          },
          "digest": {
            "type": "string"
          },
          "effects": {
            "items": {
              "$ref": "#/$defs/Effect"
            },
            "type": "array"
          },
          "expiresAt": {
            "type": "string"
          },
          "kinds": {
            "items": {
              "$ref": "#/$defs/PermissionKind"
            },
            "type": "array"
          },
          "proposalId": {
            "type": "string"
          }
        },
        "required": [
          "proposalId",
          "digest",
          "diff",
          "effects",
          "kinds",
          "expiresAt"
        ],
        "title": "FixPreviewOutput",
        "type": "object"
      },
      "title": "Preview a fix"
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "cliName": "fix-apply",
      "description": "Apply a previewed proposal. Depending on the pairing's policy the change runs now or waits for the user to approve it in Musaic; poll musaic_operation_get.",
      "id": "musaic_fix_apply",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "digest": {
            "type": "string"
          },
          "idempotencyKey": {
            "pattern": "^[A-Za-z0-9._:-]{8,128}$",
            "type": "string"
          },
          "proposalId": {
            "type": "string"
          }
        },
        "required": [
          "proposalId",

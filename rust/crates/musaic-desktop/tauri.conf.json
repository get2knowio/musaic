{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Musaic",
  "identifier": "io.get2know.musaic",
  "build": {
    "frontendDist": "shell"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "category": "Music",
    "copyright": "Copyright © Musaic contributors",
    "resources": {
      "../../../frontend/dist/": "frontend/"
    },
    "createUpdaterArtifacts": false,
    "macOS": {
      "signingIdentity": null,
      "hardenedRuntime": false
    }
  },
  "plugins": {}
}

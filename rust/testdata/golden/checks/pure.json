  "meta": [
    {
      "bulk_action_label": "Identify all",
      "category": "external",
      "cost": "cheap",
      "description": "Albums that haven't been fully identified yet — either no AcoustID fingerprints have been computed for the tracks or no MusicBrainz release-group has been matched. Both are prerequisites: fingerprints power per-track recognition + duplicate detection, and the MBID anchor unlocks cover lookups, canonical tags, and tracklist matching. Run \"Identify all\" to fingerprint + match the whole library in one pass.",
      "fix_kind": "ai-job",
      "id": "unidentified-album",
      "label": "Album not yet identified",
      "runs_during_scan": true
    },
    {
      "bulk_action_label": "Apply MusicBrainz canonical",
      "category": "metadata",
      "cost": "medium",
      "description": "Albums where Vorbis tags drift from MusicBrainz's canonical values, are missing a required field (title / artist / year / genre), or are missing the *_SORT variants used by Plex and Roon for sidebar alphabetization. Fix applies all MusicBrainz-derivable corrections in one click and falls back to AI only for fields the resolver can't fill (genre, or anything on an unanchored album).",
      "fix_kind": "ai-job",
      "id": "tags-out-of-sync",
      "label": "Tags don't match canonical",
      "runs_during_scan": false
    },
    {
      "bulk_action_label": "Try MusicBrainz on all",
      "category": "metadata",
      "cost": "cheap",
      "description": "Albums whose track-number sequence has gaps (1, 2, 4) or repeats (1, 2, 2). Detected from tag inspection — fingerprints not required to detect, but Fix uses them when available. Cascade: MB title match → AcoustID fingerprint match → AI. Note: this is about the TAG; the duplicate-tracks check catches duplicate AUDIO regardless of tag.",
      "fix_kind": "ai-job",
      "id": "track-gaps",
      "label": "Track-number gaps & duplicates",
      "runs_during_scan": true
    },
    {
      "bulk_action_label": "Propagate where possible",
      "category": "metadata",
      "cost": "cheap",
      "description": "Clusters of albums whose album_artist values are credit permutations of the same primary artist (\"Ray Conniff\" / \"Ray Conniff & His Orchestra\" / \"Ray Conniff, his Orchestra and Chorus\") but whose sort tags don't agree. Setting the same album_artist_sort across the cluster groups them under one entry in Plex / Roon sidebars.",
      "fix_kind": "deterministic",
      "id": "inconsistent-artist-sort",
      "label": "Inconsistent artist sort",
      "runs_during_scan": true
    },
    {
      "bulk_action_label": "Try MusicBrainz on all",
      "category": "cover",
      "cost": "cheap",
      "description": "Albums missing both embedded cover art and a sidecar cover.jpg / folder.jpg / front.jpg. Fix tries MusicBrainz / Cover Art Archive first (free) and falls back to AI only when MB doesn't have a cover. Albums with a recent failed lookup are skipped so bulk passes don't keep retrying dead-ends.",
      "fix_kind": "ai-job",
      "id": "no-cover-art",
      "label": "No cover art",
      "runs_during_scan": true
    },
    {
      "bulk_action_label": null,
      "category": "duplicates",
      "cost": "cheap",
      "description": "Albums with multiple files AcoustID identified as the same canonical recording — i.e. literal copies of the same audio. Requires fingerprints first (run \"Albums not yet fingerprinted\" or click Fix on a track-gaps finding). The Resolve dialog lets you pick which copy to keep.",
      "fix_kind": "deterministic",
      "id": "duplicate-tracks",
      "label": "Duplicate audio files",
      "runs_during_scan": true
    },
    {
      "bulk_action_label": null,
      "category": "files",
      "cost": "cheap",
      "description": "Multi-disc sets kept as one folder per disc, or one folder whose tracks are numbered per disc (or still carry disc tags). The layout Musaic aims for is one folder per set, tracks numbered straight through all the discs, no disc number in the file names and no disc tags. Sets are found only from disc numbers in the files' tags or in folder names such as \"(disc 2 of 3)\", never guessed. Resolve shows what a conversion does and converts a set kept in one folder; converting a set kept in several folders is not available yet.",
      "fix_kind": "deterministic",
      "id": "multi-disc-layout",
      "label": "Multi-disc set not in one folder",
      "runs_during_scan": false
    },
    {
      "bulk_action_label": null,
      "category": "files",
